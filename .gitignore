# Smoke-run output: exercises the pipeline on synthetic fixtures and is NOT
# evidence. Kept out of the repository so no synthetic number can be mistaken
# for a measured one; real runs still commit their artifacts under reports/.
reports/_smoke/
reports/**/_smoke/
/reports/inspector/

# Releases and large HTML maps
releases/
reports/figures/*.html
reports/figures/*.png

# Platform (React/Vite) build artifacts
platform/node_modules/
platform/dist/
platform/.vite/
platform/.vite-temp/
platform/.pnpm-store/
platform/.tmpbuild/


# AI Tools
.agents
.memdb
.opencode
.zcode
.qoder
notes.md

# Data artifacts
data/.tmp*
.tmp-esbuild/
/data/

# Large generated platform data (regenerate via scripts/export_platform_data.py)
platform/src/data/series_khuzestan.json

# Downloaded Google Drive archives (contents live under data/processed/, gitignored)
/google_drive/

# Mini sweep run artifacts - binaries and tracking DBs stay local (Drive if needed).
# Keep the text reports (report.json / progress.jsonl / sweep.json) committed.
reports/mini_dataset/arch_sweep/**/*.pt
reports/mini_dataset/arch_sweep/**/*.db

# Full parity dump is large and regenerable; keep the summary.
reports/mini_dataset/parity.json

# Per-run dirs are regenerable; all numbers are folded into sweep.json.
reports/mini_dataset/arch_sweep/*/*/

# Cycle-review PNGs are local review artifacts; never commit images.
reports/mini_dataset/figures/*.png

# OlmoEarth evaluation (openspec change evaluate-olmoearth-nano-sugarcane):
# embedding binaries + resume state are regenerable in <6 min (REPORT.md §10);
# tables/, figures/, raw_bin_features.parquet and REPORT.md stay committed.
experiments/olmoearth_eval/outputs/*.zarr
experiments/olmoearth_eval/outputs/*.parquet
!experiments/olmoearth_eval/outputs/raw_bin_features.parquet
experiments/olmoearth_eval/outputs/shards*/
experiments/olmoearth_eval/outputs/manifest*.jsonl
experiments/olmoearth_eval/outputs/progress*.jsonl
# vendored upstream clone (pinned 6583a536; regenerate per REPORT.md §10)
experiments/olmoearth_eval/third_party/
# model weights live outside the repo (olmoearth/weights.pth symlink)
experiments/olmoearth_eval/model_store/OlmoEarth-v1_2-Nano/weights.pth
